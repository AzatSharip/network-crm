# Dedicated new virtual host on the existing reverse proxy.
# Replace crm.example.invalid and certificate paths only after DNS/route approval.
server {
    listen 80;
    server_name crm.example.invalid;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name crm.example.invalid;
    ssl_certificate /etc/letsencrypt/live/crm.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 256k;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
